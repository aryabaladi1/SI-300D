<Window x:Class="SI_300D.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SI-300D"
        Height="300"
        Width="500">

    <StackPanel Margin="30">

        <TextBlock
            Text="{Binding ApplicationName}"
            FontSize="28"
            Margin="0,0,0,20"/>

        <TextBlock
            Text="{Binding DownloadBytesPerSecond, StringFormat=Download: {0:N0} B/s}"
            FontSize="20"
            Margin="0,0,0,10"/>

        <TextBlock
            Text="{Binding UploadBytesPerSecond, StringFormat=Upload: {0:N0} B/s}"
            FontSize="20"
            Margin="0,0,0,20"/>

        <Button
            Content="Start Monitoring"
            Click="StartMonitoring_Click"
            Margin="0,0,0,10"/>

        <Button
            Content="Stop Monitoring"
            Click="StopMonitoring_Click"/>

    </StackPanel>

</Window>