<Window x:Class="SI_300D.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SI_300D.Converters"
        Title="SI-300D"
        Height="800"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        Background="#ECEFF1">
    <Window.Resources>

        <converters:BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>

        <converters:InverseBooleanToVisibilityConverter
        x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="InterfaceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2D2D2D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,2,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkDataGridStyle" TargetType="DataGrid">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>

            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>

            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>

            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>

            <!-- Header -->
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>

                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="0,0,10,8"/>

                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEEEEE"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- Cells -->
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- Rows -->
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#2D2D2D"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAF2FF"/>
                                <Setter Property="Foreground" Value="#2D2D2D"/>
                            </Trigger>

                        </Style.Triggers>

                    </Style>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock
                    Text="{Binding ApplicationName}"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Network Monitor"
                    FontSize="14"
                    Opacity="0.6"
                    Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SI-300D -->
            <Border
                Grid.Column="0"
                Width="70"
                Height="50"
                CornerRadius="15"
                Background="White">

                <Grid>

                    <!-- Closed eyes -->
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                        <TextBlock
                            Text="—"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="—"
                            FontSize="18"
                            FontWeight="Bold"/>

                    </StackPanel>

                    <!-- Open eyes -->
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock
                            Text="●"
                            FontSize="12"
                            Margin="0,0,15,0"/>

                        <TextBlock
                            Text="●"
                            FontSize="12"/>

                    </StackPanel>

                </Grid>

            </Border>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Interface Selector -->
            <Grid Grid.Row="0" Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        Text="INTERFACE"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.6"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Margin="15,0,0,0"
                        ItemsSource="{Binding NetworkInterfaces}"
                        SelectedItem="{Binding SelectedNetworkInterface, Mode=OneWay}"
                        DisplayMemberPath="Name"
                        IsEnabled="{Binding CanStartMonitoring}"
                        SelectionChanged="InterfaceSelector_SelectionChanged"
                        Style="{StaticResource InterfaceComboBoxStyle}"/>

                    <TextBlock
                        Text="{Binding InterfaceStatusDisplay}"
                        FontSize="13"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

            <!-- Traffic -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock
                            Text="↓ DOWNLOAD"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Opacity="0.6"/>

                        <TextBlock
                            Text="{Binding DownloadSpeed}"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"/>

                        <TextBlock
                            Text="Current speed"
                            FontSize="12"
                            Opacity="0.5"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock
                            Text="↑ UPLOAD"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Opacity="0.6"/>

                        <TextBlock
                            Text="{Binding UploadSpeed}"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0"/>

                        <TextBlock
                            Text="Current speed"
                            FontSize="12"
                            Opacity="0.5"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="0,15,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,10">

                        <TextBlock
                            Text="ACTIVE TCP CONNECTIONS"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            VerticalAlignment="Center"/>

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                            <TextBlock
                                Text="Search:"
                                FontSize="13"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>

                            <TextBox
                                Width="220"
                                Height="32"
                                VerticalContentAlignment="Center"
                                Padding="10,0"
                                FontSize="13"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </Grid>

                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding FilteredTcpConnections}"
                        Style="{StaticResource NetworkDataGridStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Process"
                                Binding="{Binding ProcessName}"
                                Width="1.2*"/>

                            <DataGridTextColumn
                                Header="PID"
                                Binding="{Binding ProcessId}"
                                Width="70"/>

                            <DataGridTextColumn
                                Header="Local Address"
                                Binding="{Binding LocalAddress}"
                                Width="1.3*"/>

                            <DataGridTextColumn
                                Header="Local Port"
                                Binding="{Binding LocalPort}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Remote Address"
                                Binding="{Binding RemoteAddress}"
                                Width="1.3*"/>

                            <DataGridTextColumn
                                Header="Remote Port"
                                Binding="{Binding RemotePort}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="State"
                                Binding="{Binding State}"
                                Width="110"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>
        </Grid>

        <!-- Controls -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Start Monitoring"
                Click="StartMonitoring_Click"
                IsEnabled="{Binding CanStartMonitoring}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,0,10,0"/>

            <Button
                Content="Stop Monitoring"
                Click="StopMonitoring_Click"
                IsEnabled="{Binding CanStopMonitoring}"
                Style="{StaticResource SecondaryButtonStyle}"/>

        </StackPanel>

    </Grid>

</Window>